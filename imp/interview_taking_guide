function recalc(){
  let t=0;
  document.querySelectorAll('.q').forEach(q=>{
    const cb=q.querySelectorAll('input'), c=[...cb].filter(x=>x.checked).length;
    const s=Math.round(q.dataset.w*c/cb.length*10)/10; q.querySelector('.sc').textContent=s; t+=s;
  });
  document.getElementById('total').textContent=`Score: ${Math.round(t*10)/10} / ${MAX}`;
}
recalc();
function resetAll(){document.querySelectorAll('input').forEach(x=>x.checked=false);recalc();}
document.addEventListener('change',e=>{
  if(e.target.id==='onlyImp'){document.querySelectorAll('.q:not(.imp)').forEach(q=>q.style.display=e.target.checked?'none':'');return;}
